# Edge Function secrets. Set on the hosted project with:
#   supabase secrets set --env-file supabase/.env
# Locally, `supabase functions serve` reads supabase/.env automatically.
# Never put any of these in client code.

ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price id -> plan name, JSON
STRIPE_PRICE_MAP={"price_xxx":"driver","price_yyy":"driver_pro","price_zzz":"fleet"}
# Shared with the pg_cron job (vault secret 'cron_secret')
CRON_SECRET=
# Optional live diesel price used by run-alerts / ai-dispatcher (defaults in profit-calc.ts)
FUEL_PRICE_DIESEL=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform automatically; do not set them here.
